# Set at least one model key. With none, the app runs in demo mode with a canned guide.

# Parallel (platform.parallel.ai, $5 free credit a month): web research and the guide writer.
# Enough on its own to run the whole app.
PARALLEL_API_KEY=

# Free: https://aistudio.google.com/apikey. Needed to read screenshots; also a fallback writer.
GEMINI_API_KEY=

# Paid: https://console.anthropic.com. Used instead of the free models when set.
# ANTHROPIC_API_KEY=

# More free fallbacks: the app moves to the next one when a daily limit is hit.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional: confirms Composio toolkits and managed auth against Composio's API.
# COMPOSIO_API_KEY=

# Hosted copies: cap what strangers can spend each day (0 or unset = no cap).
# DAILY_GUIDE_LIMIT=15
# DAILY_CALL_LIMIT=300

# PORT=3000
